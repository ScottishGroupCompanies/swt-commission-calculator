# Required to sign the login cookie. Use a long random value, at least 16 characters.
# node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=

# Optional. Replaces the built-in Kelly / Sarah / admin accounts.
# JSON array of { "username", "passwordHash" }. Hashes come from:
#   node scripts/hash-password.mjs "a-new-password"
# AUTH_USERS=[{"username":"Kelly","passwordHash":"scrypt$..."}]

# Optional. Only needed to refresh Zoho job facts. Never commit real values.
ZOHO_REFRESH_TOKEN=
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
