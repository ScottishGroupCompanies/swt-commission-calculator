# Required to sign the login cookie. Use a long random value, at least 16 characters.
# node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=

# Optional. Replaces the built-in Kelly / Sarah / admin accounts.
# JSON array of { "username", "passwordHash" }. Hashes come from:
#   node scripts/hash-password.mjs "a-new-password"
# AUTH_USERS=[{"username":"Kelly","passwordHash":"scrypt$..."}]

# Named keys for the private bot API (POST/GET /api/v1/commission).
# JSON object of caller name to secret, or comma-separated name:key pairs.
# Generate a secret with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# BOT_API_KEYS={"sarah-bot":"replace-with-a-long-random-secret"}

# Optional. Set automatically when a private Vercel Blob store is connected.
# Usage history is stored there. Do not commit a token.
# BLOB_READ_WRITE_TOKEN=
# BLOB_STORE_ID=

# Optional. Only needed to refresh Zoho job facts. Never commit real values.
ZOHO_REFRESH_TOKEN=
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
